{
  "manifest_version": 3,
  "name": "LocalFirst Triage — Privacy Firewall",
  "version": "1.0.0",
  "description": "Sanitize Jira, GitHub, Zendesk, and PagerDuty incidents locally with Chrome Gemini Nano 4 before escalating to Firebase AI Logic.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open LocalFirst Triage Side Panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "contextMenus", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://github.com/*",
    "https://*.atlassian.net/*",
    "https://*.zendesk.com/*",
    "https://*.pagerduty.com/*",
    "https://*.linear.app/*",
    "https://para-1-2e22b.web.app/*"
  ]
}
