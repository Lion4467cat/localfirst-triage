{
  "manifest_version": 3,
  "name": "Cordon — On-Device AI Privacy Shield",
  "short_name": "Cordon",
  "version": "4.6.0",
  "description": "Live Browser Paste Shield & Side Panel Firewall. Blocks secrets on-device before ChatGPT, Claude, Gemini, GitHub, Slack, or Discord sees a single byte.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Cordon Shield Side Panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://github.com/*",
    "https://app.slack.com/*",
    "https://discord.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://para-1-2e22b.web.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://github.com/*",
        "https://app.slack.com/*",
        "https://discord.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "http://localhost/*"
      ],
      "js": ["firewall-core.js", "content-shield.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
